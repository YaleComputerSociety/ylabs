# Where the client sends API requests. Required: without it the client has no
# server to talk to, so the directory renders empty. Point it at the local
# Express server, which defaults to port 4000.
VITE_APP_SERVER=http://localhost:4000

# Optional error reporting. Leave unset for local work: with no DSN the client
# skips Sentry initialization entirely rather than failing.
# VITE_SENTRY_DSN=
# VITE_SENTRY_ENVIRONMENT=development
# VITE_SENTRY_RELEASE=
