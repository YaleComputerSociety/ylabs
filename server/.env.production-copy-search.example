# Copy only these values into the external operator-owned profile file
# <absolute-profile-directory>/production-copy-search.env.
# Do not create the real profile inside a repository worktree.
MEILISEARCH_HOST=<https-private-production-copy-meilisearch-host>
MEILISEARCH_API_KEY=<production-copy-read-only-baseline-api-key>
MEILISEARCH_INDEX_PREFIX=production-copy-july
PHASE0_SEARCH_BASELINE_SALT=<shared-high-entropy-comparison-salt>
