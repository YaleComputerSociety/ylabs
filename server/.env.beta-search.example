# Copy only these values into the external operator-owned profile file
# <absolute-profile-directory>/beta-search.env.
# Do not create the real profile inside a repository worktree.
MEILISEARCH_HOST=<https-private-beta-meilisearch-host>
MEILISEARCH_API_KEY=<beta-read-only-baseline-api-key>
MEILISEARCH_INDEX_PREFIX=beta
PHASE0_SEARCH_BASELINE_SALT=<shared-high-entropy-comparison-salt>
