# Copy this file to server/.env.beta-operator and keep the copy uncommitted.
# Create an Atlas database user whose roles are limited to the Beta database.
PORT=4000
MONGODBURL=mongodb+srv://<cluster>.mongodb.net/Beta
SCRAPER_ENV=beta
SESSION_SECRET=<unused-at-least-32-character-random-string>
SSOBASEURL=https://secure-tst.its.yale.edu/cas
SERVER_BASE_URL=http://localhost:4000
APP_URL=http://localhost:3000
OPENAI_API_KEY=<your-openai-key>
YALIES_API_KEY=<your-yalies-key>

# The local Beta operator fetches observations only.
# Materialization and Meilisearch synchronization run from the Beta Render shell.
