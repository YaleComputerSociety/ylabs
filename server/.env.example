# The database THIS process talks to. Required: `initializeConnections` throws
# `MONGODBURL is required` without it, so a copy of this file that omits it does not
# boot. Point it at the Development database for local work, and include an explicit
# database name in the URL, which `operatorDatabaseEnvironment` enforces so an
# operator script can name the database it is about to write.
MONGODBURL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/Development

PORT=4000
SESSION_SECRET=<any-random-string>
SSOBASEURL=https://secure-tst.its.yale.edu/cas
SERVER_BASE_URL=http://localhost:4000
OPENAI_API_KEY=<your-openai-key>
LOCAL_AUTH_BYPASS=false
LOCAL_AUTH_BYPASS_NETID=<netid>
LOCAL_AUTH_BYPASS_USER_TYPE=admin
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=local_development_master_key

# Off by default and intentionally so: this lane can only remove research homes
# from the directory. It also does nothing until a departmentRosterScraper run has
# written departmentRosterHealth observations, which is the reconciler's only
# input. Read what it would do first, without turning it on:
# `yarn --cwd server research-entity:audit-departure-lane`.
# See docs/research-data-pipeline.md before turning it on.
SCRAPER_FACULTY_DEPARTURE_DETECTION=false

# Off by default and intentionally so: this lane can only remove research homes
# from the directory. It also does nothing until a ysmAtoZScraper run has written a
# complete ysmLabIndexHealth observation, which is the reconciler's only index
# input. See docs/research-data-pipeline.md before turning it on.
SCRAPER_YSM_LAB_DELISTING_DETECTION=false

# Off by default and intentionally so: this lane retires evidence. It gates the
# in-sweep entry point only, at the end of materializeFromRun; the operator lane
# `observations:reconcile-field-retractions` plans and reports whatever this says,
# so read that first. Being absent rather than declared here is why the sweep lane
# had never been enabled in any environment and had retracted nothing (#3135).
# See docs/research-data-pipeline.md before turning it on.
SCRAPER_FIELD_RETRACTION=false

# Declared rather than left unset on purpose. Observation pruning runs in its own
# process and refuses to delete unless the materializer read scope this database is
# projected under is declared, because an absent flag is not proof it is off (#2944).
# See docs/research-data-pipeline.md before changing it.
C4_LOSSLESS_INGEST=false

# Cross-environment operations only, and not a substitute for MONGODBURL above: no
# request path reads these. They name the two ENDS of a copy or a comparison, which is
# why a promotion (`promoteAcceptedBetaCopy`) refuses to run unless the Beta and
# Production URLs are both present and different, and why the served-corpus scoreboard
# reads them to measure one environment against another. Leave them unset for ordinary
# local work.
DEVELOPMENT_MONGODBURL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>
BETA_MONGODBURL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>
PRODUCTION_MONGODBURL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>

# Optional local switches, listed because a new developer reaches for them early.
# AUTH_DEBUG turns on verbose auth tracing (per-request deserialization, the
# find-or-create cascade); genuine auth errors log either way.
# MEILISEARCH_INDEX_PREFIX must stay UNSET locally, which is what makes the local
# server read the bare `researchentities` index that `yarn meili:seed` builds.
# AUTH_DEBUG=false
# MEILISEARCH_INDEX_PREFIX=
